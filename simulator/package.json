{
  "name": "e-commerce-simulator",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.3.0",
    "@prisma/client": "7.3.0",
    "dotenv": "^17.2.1",
    "pg": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.6",
    "nodemon": "^3.1.10",
    "prisma": "7.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
